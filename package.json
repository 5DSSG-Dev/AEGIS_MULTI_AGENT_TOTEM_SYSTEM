{
  "name": "aegis-totem",
  "version": "0.1.1",
  "description": "Append-only repo memory and agent lanes for AI-assisted development.",
  "keywords": [
    "aegis",
    "ai-coding",
    "agents",
    "repo-memory",
    "developer-tools",
    "cli"
  ],
  "author": "Tracey Prutch",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "aegis-totem": "./dist/src/cli.js"
  },
  "scripts": {
    "alpha:check": "npm test && npm run typecheck && npm run build && npm pack --dry-run && npm run local-install:qa && npm run mcp:qa && npm run vscode:qa && npm run cursor:qa && npm run docs:qa && npm run release:preflight",
    "build": "tsc -p tsconfig.json",
    "docs:qa": "node scripts/docs-qa.mjs",
    "dev": "tsx src/cli.ts",
    "local-install:qa": "npm run build && node scripts/local-install-qa.mjs",
    "mcp": "node dist/src/mcp-server.js",
    "mcp:qa": "npm run build && node scripts/mcp-qa.mjs",
    "package:vscode": "npm run build && node scripts/package-vscode.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cursor:qa": "node scripts/cursor-qa.mjs",
    "vscode:qa": "npm run package:vscode && node scripts/vscode-qa.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vscode/vsce": "^3.6.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/5DSSG-Dev/AEGIS_MULTI_AGENT_TOTEM_SYSTEM.git"
  },
  "homepage": "https://github.com/5DSSG-Dev/AEGIS_MULTI_AGENT_TOTEM_SYSTEM#readme",
  "bugs": {
    "url": "https://github.com/5DSSG-Dev/AEGIS_MULTI_AGENT_TOTEM_SYSTEM/issues"
  }
}
